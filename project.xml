<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://lime.openfl.org/project/1.0.4"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">

    <!-- APP -->
    <app title="P-Slice Engine"
         file="PSliceEngine"
         package="com.mikolka9144.pslice"
         main="Main"
         version="3.4.2"
         company="mikolka9144"/>

    <meta build-number="342"/>

    <!-- WINDOW -->
    <window width="1280"
            height="720"
            fps="60"
            background="#000000"
            hardware="true"
            vsync="false"
            allow-high-dpi="true"/>

    <!-- ✅ FIX: correct source path -->
    <source path="PSliceEngine/source"/>

    <!-- ASSETS -->
    <assets path="PSliceEngine/assets/fonts"/>
    <assets path="PSliceEngine/assets/shared"/>
    <assets path="PSliceEngine/assets/week_assets" rename="assets"/>
    <assets path="PSliceEngine/example_mods" rename="mods" embed="false"/>
    <assets path="PSliceEngine/assets/videos" embed="false"/>

    <!-- LIBS -->
    <haxelib name="lime"/>
    <haxelib name="openfl"/>
    <haxelib name="flixel"/>
    <haxelib name="flixel-addons"/>
    <haxelib name="hxcpp"/>
    <haxelib name="tjson"/>
    <haxelib name="hscript-iris"/>

    <!-- DEFINES -->
    <define name="MODS_ALLOWED"/>
    <define name="HSCRIPT_ALLOWED"/>
    <define name="BASE_GAME_FILES"/>
    <define name="LUA_ALLOWED"/>
    <define name="PSYCH_WATERMARKS"/>

    <!-- iOS -->
    <section if="ios">
        <haxedef name="HXCPP_ARM64"/>
    </section>

    <!-- OPTIMIZATION -->
    <haxedef name="FLX_NO_FOCUS_LOST_SCREEN"/>
    <haxedef name="lime_disable_assets_version"/>

</project>
