<?xml version="1.0" encoding="utf-8"?>

<project
    xmlns="http://lime.openfl.org/project/1.0.4"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">

    <!-- App Info -->
    <app
        title="Friday Night Funkin': P-Slice Engine"
        file="PSliceEngine"
        package="com.mikolka9144.pslice"
        main="Main"
        version="3.4.2"
        company="mikolka9144" />

    <meta build-number="342" />

    <!-- Window Settings -->
    <window
        width="1280"
        height="720"
        fps="60"
        background="#000000"
        hardware="true"
        vsync="false"
        allow-high-dpi="true" />

    <!-- Source -->
    <classpath name="source" />

    <!-- Assets -->
    <assets path="assets/fonts" />
    <assets path="assets/shared" />
    <assets path="assets/week_assets" rename="assets" />
    <assets path="example_mods" rename="mods" embed="false" />
    <assets path="assets/videos" embed="false" />

    <!-- Dependencies -->
    <haxelib name="lime" />
    <haxelib name="openfl" />
    <haxelib name="flixel" />
    <haxelib name="flixel-addons" />
    <haxelib name="hxcpp" />
    <haxelib name="tjson" />
    <haxelib name="hscript-iris" />

    <!-- Engine Defines -->
    <define name="MODS_ALLOWED" />
    <define name="HSCRIPT_ALLOWED" />
    <define name="BASE_GAME_FILES" />
    <define name="LUA_ALLOWED" />

    <!-- Platform-specific -->
    <section if="ios">
        <haxedef name="HXCPP_ARM64" />
    </section>

    <!-- Performance / Cleanup flags -->
    <haxedef name="lime_disable_assets_version" />

</project>
