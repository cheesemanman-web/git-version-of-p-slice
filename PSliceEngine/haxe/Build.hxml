# ============ ENTRY POINT ============
-main Main

# ============ SOURCE PATHS ============
-cp source
-cp source/psychlua
-cp source/mikolka
-cp source/backend
-cp source/states

# ============ LIBS ============
-lib lime
-lib openfl
-lib flixel
-lib flixel-addons
-lib hxcpp
-lib hscript
-lib hscript-iris
-lib tjson

# ============ DEFINES ============
-D MODS_ALLOWED
-D HSCRIPT_ALLOWED
-D PSYCH_LUA
-D LUA_ALLOWED
-D PSYCH_WATERMARKS
-D BASE_GAME_FILES
-D MOBILE

# ===== FIXED iOS ICON PATH =====
-D ios.pslice-icon-dir=Images.xcassets/AppIcon.appiconset

# ============ PLATFORM FIX ============
-D sys
-D tools

--macro allowPackage("sys")

# ============ OPENFL / FLIXEL MACROS ============
--macro keep("Main")
--macro flixel.system.macros.FlxDefines.run()
--macro lime._internal.macros.DefineMacro.run()
--macro openfl.utils._internal.ExtraParamsMacro.include()
