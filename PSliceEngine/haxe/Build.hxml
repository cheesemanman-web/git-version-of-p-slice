-main Main

-cp source
-cp ../source

-lib lime
-lib openfl
-lib flixel
-lib flixel-addons
-lib hxcpp
-lib hscript
-lib hscript-iris
-lib tjson

-D MODS_ALLOWED
-D LUA_ALLOWED
-D HSCRIPT_ALLOWED
-D PSYCH_WATERMARKS
-D BASE_GAME_FILES

--macro keep("Main")
--macro keep("IntIterator")

--macro flixel.system.macros.FlxDefines.run()
--macro lime._internal.macros.DefineMacro.run()
--macro openfl.utils._internal.ExtraParamsMacro.include()

-cpp build/ios
