# ================= ENTRY =================
-main Main

# ================= SOURCE =================
-cp ../source

# ONLY include safe runtime systems
-cp ../source/states
-cp ../source/mikolka
-cp ../source/backend

# ================= LIBS =================
-lib lime
-lib openfl
-lib flixel
-lib flixel-addons
-lib hxcpp
-lib hscript
-lib hscript-iris
-lib tjson

# ================= IOS BUILD =================
-D ios
-D HXCPP_ARM64
-D mobile
-D NO_PRECOMPILED_HEADERS

# IMPORTANT: disable desktop-only systems
-D NO_FILE_SYSTEM
-D NO_MODDING_LUA

# ================= DISABLE LUA SYSTEM =================
-D LUA_ALLOWED=0
-D HSCRIPT_ALLOWED=1

# ================= MACROS =================
--macro keep("Main")
--macro flixel.system.macros.FlxDefines.run()
--macro lime._internal.macros.DefineMacro.run()
--macro openfl.utils._internal.ExtraParamsMacro.include()
