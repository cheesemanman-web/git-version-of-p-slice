-main ApplicationMain

# Main project sources
-cp ../source

# Keep the game's entry point
--macro keep("Main")
--macro keep("IntIterator")

# Libraries
-lib lime
-lib openfl
-lib flixel
-lib flixel-addons
-lib hxcpp
-lib hscript
-lib hscript-iris
-lib tjson

# OpenFL compatibility
--remap flash:openfl

# Defines
-D HXCPP_ARM64
-D ios
-D mobile

-D MODS_ALLOWED
-D LUA_ALLOWED
-D HSCRIPT_ALLOWED
-D PSYCH_WATERMARKS
-D BASE_GAME_FILES

# Macros
--macro lime._internal.macros.DefineMacro.run()
--macro openfl.utils._internal.ExtraParamsMacro.include()
