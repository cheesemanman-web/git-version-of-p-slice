# ENTRY
-main Main

# SOURCE
-cp source
-cp source/psychlua
-cp source/mikolka
-cp source/states

# LIBS
-lib lime
-lib openfl
-lib flixel
-lib flixel-addons
-lib hxcpp
-lib hscript
-lib hscript-iris
-lib tjson

# DEFINES
-D ios
-D HXCPP_ARM64
-D MODS_ALLOWED
-D HSCRIPT_ALLOWED
-D BASE_GAME_FILES
-D LUA_ALLOWED=1

# IMPORTANT iOS FIXES
-D no-file-system
-D openfl-disable-stdio

# MACROS
--macro keep("Main")
--macro flixel.system.macros.FlxDefines.run()
--macro lime._internal.macros.DefineMacro.run()
--macro openfl.utils._internal.ExtraParamsMacro.include()
