-main ApplicationMain

-cp source
-cp ../../source

-lib lime
-lib openfl
-lib flixel
-lib flixel-addons
-lib hxcpp
-lib hscript
-lib hscript-iris
-lib tjson

--remap flash:openfl

--macro keep("IntIterator")
--macro keep("Main")

-D MODS_ALLOWED
-D LUA_ALLOWED
-D HSCRIPT_ALLOWED
-D PSYCH_WATERMARKS
-D BASE_GAME_FILES

-D HXCPP_ARM64
-D ios
-D mobile

--macro lime._internal.macros.DefineMacro.run()
--macro openfl.utils._internal.ExtraParamsMacro.include()
