<?xml version="1.0" encoding="utf-8"?>

<project>

	<!-- ============ ENTRY POINT ============ -->
	<app main="Main" />

	<!-- ============ SOURCE PATHS ============ -->
	<source path="source" />
	<source path="source/psychlua" />
	<source path="source/mikolka" />
	<source path="source/backend" />
	<source path="source/states" />

	<!-- ============ LIBS ============ -->
	<haxelib name="lime" />
	<haxelib name="openfl" />
	<haxelib name="flixel" />
	<haxelib name="flixel-addons" />
	<haxelib name="hxcpp" />
	<haxelib name="hscript" />
	<haxelib name="hscript-iris" />
	<haxelib name="tjson" />

	<!-- ============ DEFINES ============ -->
	<define name="MODS_ALLOWED" />
	<define name="HSCRIPT_ALLOWED" />
	<define name="PSYCH_LUA" />
	<define name="LUA_ALLOWED" />
	<define name="PSYCH_WATERMARKS" />
	<define name="BASE_GAME_FILES" />
	<define name="MOBILE" />

	<!-- ============ PLATFORM FIX ============ -->
	<define name="sys" />
	<define name="tools" />

	<!-- ================= IOS PSLICE PERMANENT FIX ================= -->
	<!-- REQUIRED by lime-pslice fork or build WILL FAIL -->
	<set name="ios.pslice-icon-dir" value="bin/ios/PSliceEngine/Images.xcassets/AppIcon.appiconset" if="ios" />

	<!-- safe fallback for non-iOS builds -->
	<set name="ios.pslice-icon-dir" value="assets/icons" if="!ios" />

	<!-- ============ OPENFL / FLIXEL MACROS ============ -->
	<macro allowPackage="sys" />
	<macro keep="Main" />
	<macro class="flixel.system.macros.FlxDefines" method="run" />
	<macro class="lime._internal.macros.DefineMacro" method="run" />
	<macro class="openfl.utils._internal.ExtraParamsMacro" method="include" />

</project>
