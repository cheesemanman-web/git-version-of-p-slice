<?xml version="1.0" encoding="utf-8"?>

<project xmlns="http://lime.openfl.org/project/1.0.4"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">

    <app
        title="PSliceEngine"
        file="PSliceEngine"
        package="com.pslice.engine"
        main="Main"
        version="1.0.0"
        company="pslice" />

    <window width="1280" height="720" fps="60" background="#000000" />

    <classpath name="source" />

    <!-- ========================= -->
    <!-- CRITICAL FIX (THIS ONE)   -->
    <!-- ========================= -->

    <set name="ios.pslice-icon-dir" value="Images.xcassets/AppIcon.appiconset" />

    <!-- Assets -->
    <assets path="assets/fonts" />
    <assets path="assets/shared" />
    <assets path="assets/videos" embed="false" />

    <!-- Libs -->
    <haxelib name="lime" />
    <haxelib name="openfl" />
    <haxelib name="flixel" />
    <haxelib name="flixel-addons" />
    <haxelib name="hxcpp" />
    <haxelib name="tjson" />
    <haxelib name="hscript-iris" />

    <!-- Defines -->
    <define name="MODS_ALLOWED" />
    <define name="HSCRIPT_ALLOWED" />
    <define name="LUA_ALLOWED" />
    <define name="MOBILE" />

</project>
